# MariaDB (docker compose up -d)
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
DATABASE_URL=mysql://luke:change-me@127.0.0.1:3307/madebyluke

# Better Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# WebAuthn relying party: bare domain, no scheme (localhost in dev, madebyluke.dev in prod)
PASSKEY_RP_ID=localhost

# Used once by `pnpm db:seed` to create the first admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

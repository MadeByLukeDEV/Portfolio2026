# Production environment for Dokploy. See docs/DEPLOYMENT.md.

# External MariaDB (URL-encode special characters in the password)
DATABASE_URL=mysql://luke:change-me@db.example.com:3306/madebyluke

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Must match the public domain exactly
BETTER_AUTH_URL=https://madebyluke.dev
PASSKEY_RP_ID=madebyluke.dev

# Set to false once a hardware key is registered
PASSWORD_LOGIN_ENABLED=true

# Optional: skip automatic `prisma migrate deploy` on container start
# RUN_MIGRATIONS=false
